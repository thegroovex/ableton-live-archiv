{
  "name": "live-archiv",
  "productName": "Live Archiv",
  "version": "1.1.0",
  "description": "Live Archiv – Ableton-Projektarchiv und DJ-Modus als eigenständige App",
  "author": "thegroovex",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "pyinstaller --noconfirm --workpath pyi-work live-archiv-server.spec",
    "dist:mac": "electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0"
  },
  "build": {
    "appId": "com.thegroovex.livearchiv",
    "productName": "Live Archiv",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "lib.js",
      "loading.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/live-archiv-server",
        "to": "server"
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe"
        ]
      }
    ],
    "afterPack": "build/after-pack.js",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Live Archiv steuert Ableton Live, um deine Sets als MP3 zu exportieren.",
        "NSMicrophoneUsageDescription": "Live Archiv nutzt Audiogeräte wie den DDJ-FLX4 für Wiedergabe und Vorhören."
      },
      "artifactName": "Live-Archiv-macOS-arm64.${ext}"
    },
    "dmg": {
      "title": "Live Archiv ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Live-Archiv-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Live Archiv"
    }
  }
}
